{
    "name": "equinox-map",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "predev": "npm run build:worker",
        "dev": "next dev --turbopack",
        "build:convert": "ts-node --project tsconfig.scripts.json --transpile-only scripts/convert-markers.ts",
        "build:extract": "ts-node --project tsconfig.scripts.json --transpile-only scripts/extract-resources.ts",
        "build:prepare": "ts-node --project tsconfig.scripts.json --transpile-only scripts/prepare-icons.ts",
        "build:worker": "ts-node --project tsconfig.scripts.json --transpile-only scripts/copy-maplibre-worker.ts",
        "icons:upload": "ts-node --project tsconfig.scripts.json --transpile-only scripts/upload-icons.ts",
        "database:import": "ts-node --project tsconfig.scripts.json --transpile-only scripts/database/import-database.ts",
        "database:validate": "ts-node --project tsconfig.scripts.json --transpile-only scripts/database/validate-database.ts",
        "database:build": "ts-node --project tsconfig.scripts.json --transpile-only scripts/database/build-database.ts",
        "build": "npm run build:worker && npm run build:convert && npm run database:validate && npm run database:build && next build",
        "start": "next start",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "format": "prettier --write ."
    },
    "dependencies": {
        "@maplibre/maplibre-gl-style-spec": "26.4.4",
        "@phosphor-icons/react": "2.1.10",
        "driver.js": "1.9.0",
        "maplibre-gl": "6.11.2",
        "next": "16.3.8",
        "react": "19.3.0",
        "react-dom": "19.3.0"
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "3.1146.0",
        "@types/node": "26.6.4",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "eslint": "9.39.5",
        "eslint-config-next": "16.3.8",
        "prettier": "3.9.9",
        "sharp": "^0.35.5",
        "ts-node": "10.9.2",
        "typescript": "6.0.3"
    }
}
